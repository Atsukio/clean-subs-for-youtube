{
  "manifest_version": 3,
  "name": "Clean Subs for YouTube",
  "version": "1.0.0",
  "description": "Cleans up the YouTube Subscriptions page: removes 'Most relevant' and other extra sections, and adds sticky Videos and Shorts tabs.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "Clean Subs",
  "homepage_url": "https://github.com/Atsukio/clean-subs-for-youtube"
}
