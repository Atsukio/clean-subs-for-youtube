{
  "manifest_version": 3,
  "name": "Everything for YouTube",
  "short_name": "Everything for YT",
  "version": "1.2.1",
  "description": "YouTube tweaks for personal and friends' use: Subscriptions tabs and filters, hide Shorts, one-click add to Watch2Gether.",
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": [
    "https://api.w2g.tv/*",
    "https://w2g.tv/*",
    "https://www.youtube.com/oembed*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Everything for YouTube",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["lib/settings.js", "content/subs-cleaner.js", "content/yt-cleanup.js"],
      "css": ["content/theme.css", "content/subs-cleaner.css", "content/yt-cleanup.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["lib/settings.js", "content/w2g/adapters/youtube.js", "content/w2g/button.js"],
      "run_at": "document_idle"
    }
  ],
  "homepage_url": "https://github.com/Atsukio/everything-for-youtube"
}
